# Имя проект (как в package.json)
VITE_APP_NAME=pwa-base

# Включить логирование (true/false)
VITE_LOGGER_ENABLED=true

# Минимальный уровень логирования (debug/info/warn/error)
VITE_LOGGER_MIN_LEVEL=debug

# Секции, которые показываются всегда (через запятую)
VITE_LOGGER_ALWAYS_SHOW=LOGS,SYSTEM

# Принудительно показывать ошибки (даже если enabled=false)
VITE_LOGGER_FORCE_ERRORS=true
