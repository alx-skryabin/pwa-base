# В production по умолчанию выключено, но можно принудительно включить
VITE_LOGGER_ENABLED=false

# В production показываем только ошибки
VITE_LOGGER_MIN_LEVEL=error

# Только LOGS показываются всегда
VITE_LOGGER_ALWAYS_SHOW=LOGS,SYSTEM,PWA

# Принудительно показывать ошибки (даже если enabled=false)
VITE_LOGGER_FORCE_ERRORS=true
